{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "postUpdateOptions": ["gomodTidy"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Group and automerge small (non-major) updates once CI passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "pr",
      "labels": ["dependencies", "automerge"]
    },
    {
      "description": "Keep Go modules grouped separately within non-major automerge",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules (non-major)",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep GitHub Actions grouped separately within non-major automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates require Dependency Dashboard approval (no automerge)",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "modelsrv is a core dependency — always require approval",
      "matchPackageNames": ["go.emeland.io/modelsrv"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "labels": ["dependencies", "modelsrv"]
    }
  ]
}
